{
  "name": "modulero-ai",
  "version": "0.0.0",
  "private": true,
  "description": "ИИ-диалог Modulero: стенд движка и сценарии без Claude API",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "dialog": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./src/engine/register.mjs src/cli/dialog.ts",
    "engine:setup": "node scripts/engine-setup.mjs",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./src/engine/register.mjs --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "three": "0.180.0",
    "typescript": "5.9.3"
  }
}
